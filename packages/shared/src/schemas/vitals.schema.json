{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core.nimloth.io/schemas/vitals.schema.json",
  "title": "VitalsEvent",
  "allOf": [{ "$ref": "base-event.schema.json" }],
  "required": ["payload"],
  "properties": {
    "payload": {
      "type": "object",
      "required": ["observation_type", "values", "recorded_by", "recorded_at"],
      "properties": {
        "observation_type": {
          "type": "string",
          "enum": ["BLOOD_PRESSURE", "HEART_RATE", "TEMPERATURE", "SPO2", "RESPIRATORY_RATE", "WEIGHT", "HEIGHT"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["value", "unit"],
            "properties": {
              "code": { "type": "string", "description": "Snomed CT-kod" },
              "display": { "type": "string" },
              "value": { "type": "number" },
              "unit": { "type": "string", "description": "UCUM-enhet" }
            }
          }
        },
        "recorded_by": { "$ref": "base-event.schema.json#/$defs/Recorder" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "encounter_id": { "type": "string" }
      }
    }
  }
}
