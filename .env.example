# === Melior (simulerad källdatabas) ===
MELIOR_DB_HOST=melior-db
MELIOR_DB_PORT=5432
MELIOR_DB_NAME=melior
MELIOR_DB_USER=melior
MELIOR_DB_PASSWORD=melior
MELIOR_INSTANCE_ID=su

# === AsynjaVisph (simulerad källdatabas) ===
ASYNJA_DB_HOST=asynja-db
ASYNJA_DB_PORT=5432
ASYNJA_DB_NAME=asynja
ASYNJA_DB_USER=asynja
ASYNJA_DB_PASSWORD=asynja

# === Core-databas ===
CORE_DB_HOST=core-db
CORE_DB_PORT=5432
CORE_DB_NAME=core
CORE_DB_USER=core
CORE_DB_PASSWORD=core

# === Kafka ===
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=nimloth-core
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# === Debezium ===
CONNECT_URL=http://kafka-connect:8083

# === Tjänsteportar (värd-sida) ===
INGEST_PORT=3001
TRANSFORM_PORT=3002
FHIR_FACADE_PORT=3003
CDS_HOOKS_PORT=3004
AUDIT_PORT=3005
DASHBOARD_PORT=3000
REPLICATION_PORT=3007

# === FHIR Facade ===
FHIR_MODE=primary
FHIR_BASE_URL=http://fhir-facade:3003/fhir/r4

# === Edge (endast vid --distributed) ===
EDGE_INSTANCE_ID=su
EDGE_INSTANCE_NAME=Melior SU
EDGE_HOSPITAL_NAME=Sahlgrenska Universitetssjukhuset
EDGE_HSA_ID=SE2321000131-E000000000001
CENTRAL_KAFKA_BROKERS=kafka:29092
CENTRAL_FHIR_URL=http://fhir-facade:3003
CENTRAL_HEALTH_URL=http://fhir-facade:3003/health

# === Keycloak ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# === Övrigt ===
NODE_ENV=development
LOG_LEVEL=info
