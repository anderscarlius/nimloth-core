{
  "name": "@nimloth-core/composition-mapper",
  "version": "0.1.0",
  "description": "FHIR R4 → openEHR composition mapper (P4 deterministic + LLM-assisted)",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run copy-assets",
    "copy-assets": "mkdir -p dist/migrations && cp migrations/*.sql dist/migrations/",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --passWithNoTests",
    "eval": "echo 'eval-runner kommer i P4 4.8' && exit 0"
  },
  "dependencies": {
    "@nimloth-core/model-router": "workspace:*",
    "@nimloth-core/shared": "workspace:*",
    "better-sqlite3": "^11.0.0",
    "express": "^4.19.2",
    "kafkajs": "^2.2.4",
    "pino": "^9.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^1.5.0",
    "tsx": "^4.9.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
