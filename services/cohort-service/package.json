{
  "name": "@nimloth-core/cohort-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "description": "Nimloth Kohortutforskaren — HTTP-API för kohortinstantiering + sampling över omop.* (live_transform + preloaded).",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run copy-assets",
    "copy-assets": "mkdir -p dist/migrations && cp migrations/*.sql dist/migrations/",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "bulk-load": "tsx src/cli/bulk-load.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nimloth-core/shared": "workspace:*",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "pino": "^9.0.0",
    "seedrandom": "^3.0.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.6",
    "@types/seedrandom": "^3.0.8",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.9.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
