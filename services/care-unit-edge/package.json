{
  "name": "@nimloth-core/care-unit-edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run copy-migrations",
    "copy-migrations": "mkdir -p dist/migrations && cp migrations/*.sql dist/migrations/",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@nimloth-core/shared": "workspace:*",
    "better-sqlite3": "^11.0.0",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.9.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
