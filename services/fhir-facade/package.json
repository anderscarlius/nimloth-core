{
  "name": "@nimloth-core/fhir-facade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm copy-assets",
    "copy-assets": "mkdir -p dist/stores/openehr/templates && cp src/stores/openehr/templates/*.aql dist/stores/openehr/templates/",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@nimloth-core/shared": "workspace:*",
    "kafkajs": "^2.2.4",
    "pino": "^9.0.0",
    "express": "^4.19.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.6",
    "typescript": "^5.4.5",
    "tsx": "^4.9.0",
    "vitest": "^1.5.0"
  }
}
