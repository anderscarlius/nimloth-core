{
  "name": "@nimloth-core/terminology",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run copy-data",
    "copy-data": "mkdir -p dist/data && cp data/*.json dist/data/",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@nimloth-core/shared": "workspace:*",
    "express": "^4.19.2",
    "lru-cache": "^10.2.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "tsx": "^4.9.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
