# Eldar ehrbase-only — inga hemligheter krävs (publika Docker Hub-images).
# Kopiera till .env.eldar.local om du vill override:a lokalt (filen är gitignorerad
# om du lägger *.local i .gitignore; annars använd bara miljövariabler i shell).

# Host-port för smoke-script (compose-port är fast i docker-compose.eldar.yml).
EHRBASE_HOST_PORT=18124

# Valfri sökväg till OPT för smoke (default: infra/openehr/test-fixtures/...).
# OPT_FILE=/path/to/ehrbase-test-minimal-action.opt
